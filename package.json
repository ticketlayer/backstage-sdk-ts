{
  "name": "@ticketlayer/backstage",
  "version": "0.1.1",
  "description": "TypeScript SDK for Backstage API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "require": "./dist/embed/index.js",
      "import": "./dist/embed/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "embed": [
        "./dist/embed/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "npm run generate:client && npm run build",
    "generate:client": "openapi-typescript openapi.json -o src/generated/types.ts",
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsc",
    "clean": "rm -rf dist src/generated src/version.ts",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "docs": "typedoc",
    "docs:gen": "typedoc",
    "test": "npm run build && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ticketlayer/backstage-sdk-ts.git"
  },
  "homepage": "https://docs.ticketlayer.com/sdks/backstage",
  "bugs": {
    "url": "https://github.com/ticketlayer/backstage-sdk-ts/issues"
  },
  "keywords": [
    "backstage",
    "api",
    "sdk",
    "typescript",
    "openapi"
  ],
  "author": "Ticketlayer",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "ticketlayer": {
    "spec": "1.0.0",
    "apiVersion": "2026-06-13",
    "generator": "backstage-sdk-tooling 0.1.0"
  },
  "dependencies": {
    "cross-fetch": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.10.0",
    "openapi-typescript": "^7.4.3",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "^5.9.2"
  }
}
